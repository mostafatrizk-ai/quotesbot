# انسخه إلى .env وعدّل القيم
DATABASE_URL=sqlite:///./data/outreach.db
PROVIDER=mock                       # mock | cloud_api | baileys
WA_CLOUD_TOKEN=your-meta-token
WA_CLOUD_PHONE_NUMBER_ID=123456789
WA_CLOUD_VERSION=v20.0
WEBHOOK_VERIFY_TOKEN=change-me-verify-token
MESSAGES_PER_MINUTE=20
MAX_BURST=5
JITTER_SECONDS=1.5
WARMUP_ENABLED=true
API_KEY=outreach-admin-key
